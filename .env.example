APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ira Stationery (M0/M1). Storage timezone stays UTC (config/app.php);
# reporting timezone is WITA. See docs/blueprint.md §5.
REPORTING_TIMEZONE=Asia/Makassar
SIM_ACCOUNT_EMAIL_DOMAIN=sim.ira-stationery.test
# Shared simulation-account password (M4 only, SIM-08). Leave empty in
# the repo example; set it locally only, never commit a real value.
SIM_ACCOUNT_PASSWORD=
PAYMENT_EXPIRY_MINUTES=30

# Simulator (M4, SIM-02..42). Defaults follow blueprint §5 / PRD §7
# (U-02, U-03). The 100-account cap is a code constant, not an env
# value (SIM-03). SIM_GENERATOR_PYTHON empty = default per OS
# (python on Windows, python3 on Linux).
SIM_MAX_TRANSACTIONS_PER_REQUEST=500
SIM_MAX_EVENTS_PER_REQUEST=2000
SIM_MAX_PERIOD_DAYS=366
SIM_DEFAULT_MODE=deterministic
SIM_DEFAULT_SEED=20261101
SIM_GENERATOR_PYTHON=

# Payment simulator (M3b). PAYMENT_DRIVER only supports 'simulator'
# for now; any other value (or an empty one) makes the application
# fail to start with a clear message.
PAYMENT_DRIVER=simulator
# Dummy HMAC key for simulator webhook signatures (PAY-25/PAY-60).
# Generate a random local value, e.g. with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Leave empty in the repo example; set it locally only, never commit
# a real value. Without it, sim Pay/Fail actions and the expiry job
# are rejected (fail closed).
SIMULATOR_WEBHOOK_SECRET=
